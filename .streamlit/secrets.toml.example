# .streamlit/secrets.toml 로 복사해서 값을 채우세요. (이 파일은 git에 올리지 마세요)
APP_PASSWORD = ""        # 홈페이지 접근 암호. 비우면 잠금이 걸리지 않습니다
NCBI_API_KEY = ""        # 선택. 있으면 초당 10회, 없으면 3회
NCBI_TOOL_EMAIL = ""     # 선택. NCBI 권장
GEMINI_API_KEY = ""      # 선택. 없으면 "AI로 고도화" 버튼이 비활성화됩니다
GEMINI_MODEL = "gemini-2.5-pro"
GITHUB_REPO = ""         # 선택. 일일 스냅샷을 비공개 저장소에서 읽을 때 "owner/repo"
GITHUB_TOKEN = ""
GITHUB_BRANCH = "main"
